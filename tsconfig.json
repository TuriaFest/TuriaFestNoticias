{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@data/*": ["src/data/*"],
      "@i18n/*": ["src/i18n/*"],
      "@lib/*": ["src/lib/*"],
      "@assets/*": ["src/assets/*"]
    },
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", ".astro/types.d.ts", "vitest.config.mts"]
}
