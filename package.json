{
  "name": "turia-fest-noticias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "watch": "astro dev",
    "test": "vitest",
    "lint": "astro check",
    "deploy": "npm run build && wrangler deploy",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:check": "node scripts/i18n-sync.mjs --check",
    "sync:codex": "node scripts/sync-codex.mjs",
    "sync:codex:check": "node scripts/sync-codex.mjs --check",
    "images:convert": "node scripts/convert-images.mjs",
    "branches:update-from-develop": "bash scripts/update-branches-from-develop.sh",
    "branches:merge-develop-into-all": "bash scripts/merge-develop-into-branches.sh",
    "predev": "npm run copy:i18n",
    "prebuild": "npm run copy:i18n",
    "copy:i18n": "node scripts/copy-i18n.mjs"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.0.0",
    "jsdom": "^30.0.1",
    "sass": "^1.102.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
